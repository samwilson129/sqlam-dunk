# Supabase client configuration for Cloudflare Pages Production and Preview
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
# Legacy projects may use this instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Optional v0 preview redirect proxy; omit for Cloudflare production/preview.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
