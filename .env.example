# Supabase Auth. Both values are public (they ship to the browser) and are
# inlined at BUILD time by the static export, so set them as build environment
# variables in Cloudflare Pages (Settings > Variables and Secrets, for both
# Production and Preview) and redeploy. Never put a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy alternative to the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
